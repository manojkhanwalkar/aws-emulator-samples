<?xml version="1.0" encoding="UTF-8"?>
<!--
  AWS Emulator samples: small programs that show how to use AWS Emulator
  (https://docs.aws.amazon.com/emulator/) from Java with the AWS SDK for Java 2.x.

  Open this folder in IntelliJ IDEA (File > Open), let it import the Maven project, start the
  emulator (`aws-emulator` in a terminal), then run any sample with the green arrow next to its
  `main` method, or pick one from the run configurations in the toolbar. See README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>samples</groupId>
    <artifactId>aws-emulator-samples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>AWS Emulator samples</name>

    <properties>
        <!-- Java 21 or later. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aws-sdk.version>2.58.0</aws-sdk.version>
        <junit.version>6.1.3</junit.version>
        <slf4j.version>2.0.20</slf4j.version>
        <!-- What `mvn exec:java` runs; pick another sample with -Dexec.mainClass=samples.S02_S3Buckets -->
        <exec.mainClass>samples.RunAllSamples</exec.mainClass>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The AWS SDK's bill of materials keeps every service module on the same version. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- One module per AWS service the samples use. The code is the same as for real AWS. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
        </dependency>
        <!-- The HTTP client the samples configure to trust the emulator's own HTTPS certificate. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>

        <!-- Quiet logging: the SDK logs through SLF4J; this prints warnings and errors only
             (see src/main/resources/simplelogger.properties). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <!-- Lets you run a sample from a terminal too:
                 mvn -q compile exec:java -Dexec.mainClass=samples.S01_ConnectAndCheck -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
            </plugin>
        </plugins>
    </build>
</project>
